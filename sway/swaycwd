#!/bin/sh
# Print the CWD of the focused window's shell, falling back to $HOME.
FOCUSED=$(swaymsg -t get_tree | jq -c '.. | select(.focused?)')
PID=$(echo "$FOCUSED" | jq -r '.pid')

# kitty is single-instance (shared pid), so ask it over its control socket
if [ "$(echo "$FOCUSED" | jq -r '.app_id')" = kitty ]; then
	CWD=$(kitty @ --to "unix:@mykitty-$PID" ls 2>/dev/null | jq -r '
		.[] | select(.is_focused) | .tabs[] | select(.is_active)
		| .windows[] | select(.is_focused)
		| (.foreground_processes[0].cwd // .cwd) // empty')
	[ -n "$CWD" ] && { echo "$CWD"; exit 0; }
fi

# other terminals: BFS the process tree for a shell, skipping helper processes
QUEUE=$PID
while [ -n "$QUEUE" ]; do
	NEXT=
	for P in $QUEUE; do
		case "$(cat "/proc/$P/comm" 2>/dev/null)" in
		zsh | bash | fish | sh | ash)
			readlink "/proc/$P/cwd" && exit 0
			;;
		esac
		NEXT="$NEXT $(pgrep -P "$P")"
	done
	QUEUE=${NEXT# }
done
echo "$HOME"
