### Output configuration
#
# You can get the names of your outputs by running: swaymsg -t get_outputs

output eDP-1 enable scale 1.5 position 0,0 mode 2880x1800@120.000Hz
output * bg ~/.config/sway/bg/mountains.jpg fill

### Idle configuration

exec swayidle -w \
         timeout 300 'swaylock -f -c 000000' \
         timeout 300 'swaymsg "output * power off"' \
         resume 'swaymsg "output * power on"' \
         before-sleep 'swaylock -f -c 000000'

### Input configuration
#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.

input type:keyboard {
    xkb_layout eu,us
    xkb_model "pc105"
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
    scroll_factor 2
}

bindsym XF86MonBrightnessUp exec brillo -A 2 && (echo "$(brillo -G) / 1" | bc > $WOBSOCK)
bindsym XF86MonBrightnessDown exec brillo -U 2 && (echo "$(brillo -G) / 1" | bc > $WOBSOCK)


exec_always ~/.config/kanshi/run.sh
